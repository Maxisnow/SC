local function watchTrailFolder(plr)
    if trailConnections[plr] then
        trailConnections[plr]:Disconnect()
    end
    
    local trails = plr:FindFirstChild("trails")
    if trails then
        trailConnections[plr] = trails.ChildAdded:Connect(function()
            if selectedPlayer == plr then updateTrailList(plr) end
        end)
        trails.ChildRemoved:Connect(function()
            if selectedPlayer == plr then updateTrailList(plr) end
        end)
    end
end

local function renderPlayerList()
    for _, item in pairs(playerListScrolling:GetChildren()) do
        if item:IsA("TextButton") then item:Destroy() end
    end
    
    for _, plr in ipairs(players:GetPlayers()) do
        local btn = Instance.new("TextButton")
        btn.Parent = playerListScrolling
        btn.Size = UDim2.new(1, -5, 0, 26)
        btn.Text = plr.Name
        btn.TextColor3 = plr == player and Color3.fromRGB(60, 200, 255) or Color3.fromRGB(220, 230, 255)
        btn.BackgroundColor3 = plr == selectedPlayer and Color3.fromRGB(60, 120, 255) or Color3.fromRGB(10, 20, 42)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 13
        btn.BorderSizePixel = 0
        
        local btnCorner = Instance.new("UICorner")
        btnCorner.Parent = btn
        btnCorner.CornerRadius = UDim.new(0, 5)
        
        btn.MouseEnter:Connect(function()
            if btn.BackgroundColor3 ~= Color3.fromRGB(60, 120, 255) then
                tweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(20, 40, 80)}):Play()
            end
        end)
        
        btn.MouseLeave:Connect(function()
            if btn.BackgroundColor3 ~= Color3.fromRGB(60, 120, 255) then
                tweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(10, 20, 42)}):Play()
            end
        end)
        
        btn.MouseButton1Click:Connect(function()
            for _, b in pairs(playerListScrolling:GetChildren()) do
                if b:IsA("TextButton") then
                    b.BackgroundColor3 = Color3.fromRGB(10, 20, 42)
                end
            end
            btn.BackgroundColor3 = Color3.fromRGB(60, 120, 255)
            selectedPlayer = plr
            updateTrailList(plr)
            watchTrailFolder(plr)
        end)
    end
end

