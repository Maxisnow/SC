    rejoinBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 90)
    rejoinBtn.Font = Enum.Font.GothamBold
    rejoinBtn.TextSize = 14
    rejoinBtn.BorderSizePixel = 0

    local rejoinCorner = Instance.new("UICorner")
    rejoinCorner.CornerRadius = UDim.new(0, 10)
    rejoinCorner.Parent = rejoinBtn

    rejoinBtn.MouseEnter:Connect(function()
        tweenService:Create(rejoinBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(75, 75, 120)}):Play()
    end)

    rejoinBtn.MouseLeave:Connect(function()
        tweenService:Create(rejoinBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(55, 55, 90)}):Play()
    end)

    rejoinBtn.MouseButton1Click:Connect(function()
        timerRunning = false
        local placeId = game.PlaceId
        TeleportService:Teleport(placeId, player)
    end)

    miscY = miscY + 52

    local closeMenuButton = Instance.new("TextButton")
    closeMenuButton.Parent = miscPage
    closeMenuButton.BackgroundColor3 = Color3.fromRGB(180, 30, 30)
    closeMenuButton.Position = UDim2.new(0.04, 0, 0, miscY)
    closeMenuButton.Size = UDim2.new(0.92, 0, 0, 42)
    closeMenuButton.Font = Enum.Font.GothamBold
    closeMenuButton.Text = "CLOSE MENU"
    closeMenuButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeMenuButton.TextSize = 14
    closeMenuButton.BorderSizePixel = 0

    local closeMenuCorner = Instance.new("UICorner")
    closeMenuCorner.Parent = closeMenuButton
    closeMenuCorner.CornerRadius = UDim.new(0, 10)

    closeMenuButton.MouseEnter:Connect(function()
        tweenService:Create(closeMenuButton, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(220, 40, 40)}):Play()
    end)

    closeMenuButton.MouseLeave:Connect(function()
        tweenService:Create(closeMenuButton, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(180, 30, 30)}):Play()
    end)

    closeMenuButton.MouseButton1Click:Connect(function()
        timerRunning = false
        for state, _ in pairs(collectingState) do
            collectingState[state] = false
        end
        
        for _, conn in pairs(trailConnections) do
            if conn then
                conn:Disconnect()
            end
        end
        trailConnections = {}
        
        MainFrame.Visible = false
        ScreenGui:Destroy()
    end)

    miscY = miscY + 55

    local restartLabel = Instance.new("TextLabel")
    restartLabel.Parent = miscPage
    restartLabel.BackgroundTransparency = 1
    restartLabel.Position = UDim2.new(0.04, 0, 0, miscY)
    restartLabel.Size = UDim2.new(0.92, 0, 0, 30)
    restartLabel.Font = Enum.Font.Gotham
    restartLabel.Text = "Restart script to reload menu"
    restartLabel.TextColor3 = Color3.fromRGB(140, 180, 220)
    restartLabel.TextSize = 12
    restartLabel.TextXAlignment = Enum.TextXAlignment.Left

    miscPage.CanvasSize = UDim2.new(0, 0, 0, miscY + 40)

    local VirtualUser = game:GetService("VirtualUser")
    player.Idled:Connect(function()
        VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        wait(1)
        VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    end)
end

local function checkKey()
    if keyBox.Text == "aMYJrrF2Y" then
        createMenu()
    else
        errorLabel.Text = "Invalid key. Try again."
        errorLabel.Visible = true
        keyBox.Text = ""
        keyBox:CaptureFocus()
        task.delay(2, function()
            errorLabel.Visible = false
        end)
    end
end

confirmButton.MouseButton1Click:Connect(checkKey)

keyBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        checkKey()
    end
end)

keyBox:CaptureFocus()

return ChernushkaSpeed
