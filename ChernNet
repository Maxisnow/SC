            local p2ItemsLabel = Instance.new("TextLabel")
            p2ItemsLabel.Parent = mainLabel
            p2ItemsLabel.BackgroundTransparency = 1
            p2ItemsLabel.Position = UDim2.new(0.5, 6, 0, 36)
            p2ItemsLabel.Size = UDim2.new(0.5, -12, 1, -46)
            p2ItemsLabel.Font = Enum.Font.Gotham
