local function createToggle(parent, pos, name, default, callback)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.BackgroundColor3 = Color3.fromRGB(8, 16, 34)
    frame.Position = UDim2.new(0, 10, 0, pos)
    frame.Size = UDim2.new(1, -20, 0, 52)
    frame.Name = name .. "Frame"
    frame.ZIndex = 1
    
    local corner = Instance.new("UICorner")
    corner.Parent = frame
    corner.CornerRadius = UDim.new(0, 10)
    
    frame.MouseEnter:Connect(function()
        tweenService:Create(frame, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(12, 22, 48)}):Play()
    end)
    
    frame.MouseLeave:Connect(function()
        tweenService:Create(frame, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(8, 16, 34)}):Play()
    end)
    
    local label = Instance.new("TextLabel")
    label.Parent = frame
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 14, 0, 4)
    label.Size = UDim2.new(0, 320, 1, -8)
    label.Font = Enum.Font.GothamBold
    label.Text = name
    label.TextColor3 = Color3.fromRGB(210, 225, 255)
    label.TextSize = 15
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 2
    
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Parent = frame
    toggleBtn.BackgroundColor3 = default and Color3.fromRGB(60, 120, 255) or Color3.fromRGB(30, 40, 70)
    toggleBtn.Position = UDim2.new(1, -56, 0.5, -14)
    toggleBtn.Size = UDim2.new(0, 48, 0, 28)
    toggleBtn.Text = ""
    toggleBtn.AutoButtonColor = false
    toggleBtn.ZIndex = 2
    
    local toggleCorner = Instance.new("UICorner")
    toggleCorner.Parent = toggleBtn
    toggleCorner.CornerRadius = UDim.new(1, 0)
    
    local inner = Instance.new("Frame")
    inner.Parent = toggleBtn
    inner.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    inner.Position = default and UDim2.new(1, -24, 0.5, -11) or UDim2.new(0, 3, 0.5, -11)
    inner.Size = UDim2.new(0, 22, 0, 22)
    inner.ZIndex = 3
    
    local innerCorner = Instance.new("UICorner")
    innerCorner.Parent = inner
    innerCorner.CornerRadius = UDim.new(1, 0)
    
    local state = default or false
    
    task.spawn(function()
        callback(state)
    end)
    
    toggleBtn.MouseEnter:Connect(function()
        if state then
            tweenService:Create(toggleBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(80, 150, 255)}):Play()
        else
            tweenService:Create(toggleBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(40, 55, 90)}):Play()
        end
    end)
    
    toggleBtn.MouseLeave:Connect(function()
        if state then
            tweenService:Create(toggleBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(60, 120, 255)}):Play()
        else
            tweenService:Create(toggleBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(30, 40, 70)}):Play()
        end
    end)
    
    toggleBtn.MouseButton1Click:Connect(function()
        state = not state
        toggleBtn.BackgroundColor3 = state and Color3.fromRGB(60, 120, 255) or Color3.fromRGB(30, 40, 70)
        local targetPos = state and UDim2.new(1, -24, 0.5, -11) or UDim2.new(0, 3, 0.5, -11)
        tweenService:Create(inner, TweenInfo.new(0.12), {Position = targetPos}):Play()
        callback(state)
    end)
    
    return frame
end

