if TradeSessions then
    local function createSessionLabel(session)
        if not session:IsA("Folder") then return end
        
        local player1 = session:FindFirstChild("Player1")
        local player2 = session:FindFirstChild("Player2")
        local p1Accept = session:FindFirstChild("Player1Accept")
        local p2Accept = session:FindFirstChild("Player2Accept")
        local p1Trading = session:FindFirstChild("Player1Trading")
        local p2Trading = session:FindFirstChild("Player2Trading")
        
        if not (player1 and player2 and p1Accept and p2Accept and p1Trading and p2Trading) then
            return
        end
        
        local mainLabel = Instance.new("Frame")
        mainLabel.Parent = tradeScrollFrame
        mainLabel.BackgroundColor3 = Color3.fromRGB(10, 20, 42)
        mainLabel.Size = UDim2.new(1, -10, 0, 130)
        mainLabel.BackgroundTransparency = 0
        
        local mainCorner = Instance.new("UICorner")
        mainCorner.Parent = mainLabel
        mainCorner.CornerRadius = UDim.new(0, 8)
        
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Parent = mainLabel
        nameLabel.BackgroundTransparency = 1
        nameLabel.Position = UDim2.new(0, 8, 0, 4)
        nameLabel.Size = UDim2.new(1, -80, 0, 28)
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.Text = player1.Value .. "  <->  " .. player2.Value
        nameLabel.TextColor3 = Color3.fromRGB(60, 160, 255)
        nameLabel.TextSize = 15
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        
        local stateLabel = Instance.new("TextLabel")
        stateLabel.Parent = mainLabel
        stateLabel.BackgroundTransparency = 1
        stateLabel.Position = UDim2.new(1, -70, 0, 4)
        stateLabel.Size = UDim2.new(0, 65, 0, 28)
        stateLabel.Font = Enum.Font.GothamBold
        stateLabel.Text = "0/2"
        stateLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        stateLabel.TextSize = 14
        stateLabel.TextXAlignment = Enum.TextXAlignment.Right
        
        local p1ItemsLabel = Instance.new("TextLabel")
        p1ItemsLabel.Parent = mainLabel
        p1ItemsLabel.BackgroundTransparency = 1
        p1ItemsLabel.Position = UDim2.new(0, 8, 0, 36)
        p1ItemsLabel.Size = UDim2.new(0.5, -12, 1, -46)
        p1ItemsLabel.Font = Enum.Font.Gotham
        p1ItemsLabel.Text = ""
        p1ItemsLabel.TextColor3 = Color3.fromRGB(180, 200, 230)
        p1ItemsLabel.TextSize = 12
        p1ItemsLabel.TextXAlignment = Enum.TextXAlignment.Left
        p1ItemsLabel.TextYAlignment = Enum.TextYAlignment.Top
        p1ItemsLabel.TextWrapped = true
        p1ItemsLabel.TextScaled = false
        
        local p2ItemsLabel = Instance.new("TextLabel")
        p2ItemsLabel.Parent = mainLabel
        p2ItemsLabel.BackgroundTransparency = 1
        p2ItemsLabel.Position = UDim2.new(0.5, 6, 0, 36)
        p2ItemsLabel.Size = UDim2.new(0.5, -12, 1, -46)
        p2ItemsLabel.Font = Enum.Font.Gotham
        p2ItemsLabel.Text = ""
        p2ItemsLabel.TextColor3 = Color3.fromRGB(180, 200, 230)
        p2ItemsLabel.TextSize = 12
        p2ItemsLabel.TextXAlignment = Enum.TextXAlignment.Left
        p2ItemsLabel.TextYAlignment = Enum.TextYAlignment.Top
        p2ItemsLabel.TextWrapped = true
        p2ItemsLabel.TextScaled = false
        
        local function updateState()
            local acceptedCount = (p1Accept.Value and 1 or 0) + (p2Accept.Value and 1 or 0)
            if acceptedCount == 2 then
                stateLabel.Text = "ACCEPTED"
                stateLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
                task.delay(3, function()
                    if mainLabel and mainLabel.Parent then
                        mainLabel:Destroy()
                    end
                end)
            else
                stateLabel.Text = acceptedCount .. "/2"
                stateLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
        end
        
        local function updateTrading()
            local p1Items = {}
            for _, item in pairs(p1Trading:GetChildren()) do
                table.insert(p1Items, "- " .. item.Name)
            end
            p1ItemsLabel.Text = table.concat(p1Items, "\n") or "No items"
            
            local p2Items = {}
            for _, item in pairs(p2Trading:GetChildren()) do
                table.insert(p2Items, "- " .. item.Name)
            end
            p2ItemsLabel.Text = table.concat(p2Items, "\n") or "No items"
        end
        
        local p1AcceptConn = p1Accept:GetPropertyChangedSignal("Value"):Connect(updateState)
        local p2AcceptConn = p2Accept:GetPropertyChangedSignal("Value"):Connect(updateState)
        
        local p1AddedConn = p1Trading.ChildAdded:Connect(updateTrading)
        local p1RemovedConn = p1Trading.ChildRemoved:Connect(updateTrading)
        local p2AddedConn = p2Trading.ChildAdded:Connect(updateTrading)
        local p2RemovedConn = p2Trading.ChildRemoved:Connect(updateTrading)
        
        updateState()
        updateTrading()
        
        local stop = false
        local ancestryConn
        ancestryConn = session.AncestryChanged:Connect(function(_, parent)
            if stop then return end
            if not parent then
                local acceptedCount = (p1Accept.Value and 1 or 0) + (p2Accept.Value and 1 or 0)
                if acceptedCount == 2 then
                    stateLabel.Text = "ACCEPTED"
                    stateLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
                    task.delay(3, function()
                        if mainLabel and mainLabel.Parent then
                            mainLabel:Destroy()
                        end
                    end)
                else
                    stateLabel.Text = "CANCELLED"
                    stateLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
                    task.delay(3, function()
                        if mainLabel and mainLabel.Parent then
                            mainLabel:Destroy()
                        end
                    end)
                end
                stop = true
            end
        end)
        
        mainLabel.Destroying:Connect(function()
            p1AcceptConn:Disconnect()
            p2AcceptConn:Disconnect()
            p1AddedConn:Disconnect()
            p1RemovedConn:Disconnect()
            p2AddedConn:Disconnect()
            p2RemovedConn:Disconnect()
            ancestryConn:Disconnect()
        end)
    end
    
    TradeSessions.ChildAdded:Connect(function(child)
        task.wait(0.1)
        createSessionLabel(child)
    end)
    
    for _, session in ipairs(TradeSessions:GetChildren()) do
        createSessionLabel(session)
    end
end

