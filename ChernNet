    local function teleportToObject(obj)
        if obj and obj:IsA("Model") then
            local primaryPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if primaryPart and character and character.PrimaryPart then
                character:SetPrimaryPartCFrame(primaryPart.CFrame * CFrame.new(0, 2, 0))
                return true
            end
        end
        return false
    end

    local function collectTrillionaireOrbs()
        while collectingState.trillionaire do
            pcall(function()
                local city = workspace:FindFirstChild("TrillionaireCity")
                if city then
                    local folder = city:FindFirstChild("TrillionaireOrbs")
                    if folder then
                        for _, obj in ipairs(folder:GetChildren()) do
                            if collectingState.trillionaire and obj:IsA("Model") and obj.Name:find("Trillionaire") then
                                teleportToObject(obj)
                                wait(0.2)
                            end
                        end
                    end
                end
            end)
            wait(0.5)
        end
    end

